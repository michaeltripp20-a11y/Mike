# Anthropic API key — get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Substack session cookie — grab from browser DevTools:
# 1. Log into substack.com
# 2. Open DevTools > Application > Cookies > https://substack.com
# 3. Copy the value of the "connect.sid" cookie
SUBSTACK_SESSION_COOKIE=s%3A...

# Your Substack publication subdomain (the part before .substack.com)
SUBSTACK_PUBLICATION=thefloorreport
