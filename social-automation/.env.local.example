# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit .env.local or paste these values into chat/version control.

# From your LinkedIn Developer app (https://www.linkedin.com/developers/apps)
# — used only by scripts/linkedin-auth.mjs, not by the running app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Printed by `node --env-file=.env.local scripts/linkedin-auth.mjs` after
# you approve access in a browser. These are what api/publish/linkedin.ts
# actually uses to post — set them here for local `vercel dev`, and again
# in your Vercel project's Environment Variables for the real deployment.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Optional — override if LinkedIn's current API version differs from the
# default baked into api/publish/linkedin.ts.
LINKEDIN_API_VERSION=
