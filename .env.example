# Copy to .env and fill in real values. Never commit .env.

# Where the Vite dev server runs (used for post-OAuth redirects)
FRONTEND_ORIGIN=http://localhost:5173

# Port the automation backend (server/index.js) listens on
PORT=8787

# --- Facebook ---
# Create an app at https://developers.facebook.com/apps
# Add the "Facebook Login" product, and request pages_show_list,
# pages_manage_posts, pages_read_engagement permissions.
FB_APP_ID=
FB_APP_SECRET=
# Must exactly match a "Valid OAuth Redirect URI" configured on the app
FB_REDIRECT_URI=http://localhost:8787/auth/facebook/callback
# Optional: Page ID to post to, if the connected user manages more than one
FB_PAGE_ID=

# --- LinkedIn ---
# Create an app at https://www.linkedin.com/developers/apps
# Request the "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn" products (scopes: openid, profile, w_member_social)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URL" configured on the app
LINKEDIN_REDIRECT_URI=http://localhost:8787/auth/linkedin/callback
